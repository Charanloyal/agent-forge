# Application Configuration
APP_NAME=AgentForge
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentforge
# Optional direct URI override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentforge

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=agentforge_chunks
# QDRANT_API_KEY=

# Neural Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & Fusion Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K_DENSE=15
TOP_K_SPARSE=15
RRF_K=60
TOP_K_FUSED=10
TOP_K_RERANKED=5

# Agentic Evaluation & Gate Thresholds
RERANKER_SCORE_THRESHOLD=0.20
RELEVANCE_PASS_THRESHOLD=0.25
FAITHFULNESS_PASS_THRESHOLD=0.60
MAX_REFLECTION_ITERATIONS=2
